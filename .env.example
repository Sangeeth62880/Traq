# ==============================================================================
# TRAQ — Environment Variables
# ==============================================================================
# Copy to .env and fill in values. NEVER commit .env to version control.
# ==============================================================================

# Firebase


# Database (v2.1)
SQLITE_DB_PATH=./var/traq_local.db
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=my-super-secret-auth-token
INFLUX_ORG=traq_org
INFLUX_BUCKET=traq_telemetry
REDIS_URL=redis://localhost:6379

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# External APIs
RAILRADAR_API_KEY=

# Services
ML_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:3000

# Security
TICKET_SIGNING_SECRET=
TICKET_SIGNING_SECRET_K1=
TICKET_KEY_ID=k1
IOT_API_KEY_HASH=

# IoT Hardware — Coach Capacities
COACH_CAPACITY_SLEEPER=72
COACH_CAPACITY_AC3=64
COACH_CAPACITY_AC2=46
OCCUPANCY_ALERT_THRESHOLD=85

# nRF52833 UART baud rate (used in simulator)
NRF_UART_BAUD=115200

# AD8318 calibration constants
AD8318_SLOPE_MV_PER_DB=-25.0
AD8318_INTERCEPT_DBM=20.0
ADS1115_I2C_ADDR=0x48
